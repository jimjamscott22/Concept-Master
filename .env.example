DB_HOST=127.0.0.1
DB_PORT=3306
# setup_db.py requires DB_USER and DB_NAME to use only letters, numbers, and underscores
DB_USER=your_mysql_username
DB_PASS=your_mysql_password
# setup_db.py expects DB_NAME to use letters/numbers/underscores
DB_NAME=concept_master

# Daily Concept is opt-in. No generation happens on startup or web requests.
DAILY_CONCEPT_ENABLED=false
DAILY_TIMEZONE=America/New_York
# Set explicitly to a model available to your Anthropic account.
# Official model ID verified during implementation; availability may change.
DAILY_LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# These v2 controls stay off; requiring approval is rejected by the MVP CLI.
DAILY_ADMIN_ENABLED=false
DAILY_REQUIRE_APPROVAL=false
